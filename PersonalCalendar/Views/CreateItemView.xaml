<Window x:Class="PersonalCalendar.Views.CreateItemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un élément"
        Height="520"
        Width="550"
        MinHeight="520"
        MinWidth="550"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Créer un élément"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="DarkSlateGray"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">

            <RadioButton Content="Événement"
                         IsChecked="{Binding IsEventSelected}"
                         GroupName="ItemType"
                         FontSize="15"
                         Margin="0,0,25,0"/>

            <RadioButton Content="Tâche"
                         IsChecked="{Binding IsTaskSelected}"
                         GroupName="ItemType"
                         FontSize="15"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Titre"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Padding="6"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Description"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Date"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="{Binding Date}"
                           FontSize="15"
                           Foreground="DarkSlateGray"
                           Margin="0,0,0,15"/>

                <CheckBox Content="Toute la journée"
                          IsChecked="{Binding IsAllDay}"
                          FontSize="14"
                          Margin="0,0,0,15"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Margin="0,15,0,0">

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <Button Content="Créer"
                    Command="{Binding CreateItemCommand}"
                    Height="38"
                    Width="120"
                    HorizontalAlignment="Right"
                    Background="SteelBlue"
                    Foreground="White"
                    FontWeight="SemiBold"/>
        </StackPanel>

    </Grid>
</Window>
